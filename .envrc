
layout python python3

# Endpoint de Mimir (bajo el prefijo /prometheus) y tenant (X-Scope-OrgID).
# Por defecto: Prometheus local (http://localhost:9090/api/v1/query), sin tenant.
export METRICS_URL="https://mimir.example.com/prometheus/api/v1/query"
export METRICS_ORG_ID=""

# Archivo YAML con las consultas del reporte (ver queries.example.yaml).
# También se puede pasar con --config; --query (repetible) lo ignora.
# export REPORT_CONFIG="queries.yaml"

# Título del reporte (el del YAML y --title tienen prioridad)
# export REPORT_TITLE="Reporte de métricas"

# Envío por correo (Amazon SES) - solo se usa con: python report.py --send
# Sin SES_SMTP_USER/SES_SMTP_PASSWORD usa la API de SES con las credenciales de
# AWS por defecto (IRSA en EKS, AWS_PROFILE, AWS_ACCESS_KEY_ID, etc.).
export AWS_REGION=""
export SES_SENDER=""
export SES_TO=""
# export SES_SUBJECT="Reporte de tiempos de respuesta"

# Credenciales SMTP de SES (crear en la consola de SES -> SMTP settings).
# NO son las AWS access keys; son un usuario/clave SMTP específicos.
# export SES_SMTP_USER=""
# export SES_SMTP_PASSWORD=""
# Host/puerto opcionales; por defecto: email-smtp.$AWS_REGION.amazonaws.com : 587 (STARTTLS)
# export SES_SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
# export SES_SMTP_PORT="587"
